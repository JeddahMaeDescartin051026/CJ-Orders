rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {

      // The public website may only CREATE a well-formed new order.
      allow create: if request.resource.data.keys().hasOnly(
                         ['name','phone','social','address','items','total','status','note','createdAt'])
                    && request.resource.data.name is string    && request.resource.data.name.size()    <= 100
                    && request.resource.data.phone is string   && request.resource.data.phone.size()   <= 30
                    && request.resource.data.social is string  && request.resource.data.social.size()  <= 200
                    && request.resource.data.address is string && request.resource.data.address.size() <= 500
                    && request.resource.data.items is list     && request.resource.data.items.size()   <= 50
                    && request.resource.data.total is number
                    && request.resource.data.status == 'NOT COMPLETED'
                    && request.resource.data.note == ''
                    && request.resource.data.createdAt == request.time;

      // Only you can read, update or delete orders. Put YOUR login email below.
      allow read, update, delete: if request.auth != null
                                  && request.auth.token.email == 'PASTE_YOUR_ADMIN_EMAIL_HERE';
    }
  }
}
